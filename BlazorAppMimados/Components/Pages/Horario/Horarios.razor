@page "/horarios"
@using BlazorAppMimados.Models
@using BlazorAppMimados.Services
@inject IHorarioLaboralService HorarioService
@inject IEmpleadoService EmpleadoService

<div class="mb-4">
    <h3 class="m-0 text-dark fw-bold">Gestión de Horarios del Personal</h3>
</div>

@if (!string.IsNullOrEmpty(mensajeAlerta))
{
    <div class="alert alert-info mb-3">@mensajeAlerta</div>
}

<div class="row g-4">
    <!-- Formulario para asignar horario -->
    <div class="col-lg-4">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-primary text-white">
                <h5 class="card-title m-0 fw-bold">Asignar Horario</h5>
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <label class="form-label fw-bold">Veterinario</label>
                    <select class="form-select" @bind="nuevoHorario.EmpleadoId">
                        <option value="0">Seleccione un veterinario...</option>
                        @if (listaEmpleados != null)
                        {
                            @foreach (var emp in listaEmpleados)
                            {
                                <option value="@emp.Id">@emp.Nombres @emp.Apellidos</option>
                            }
                        }
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold">Día de la semana</label>
                    <select class="form-select" @bind="nuevoHorario.DiaSemana">
                        <option value="LUNES">Lunes</option>
                        <option value="MARTES">Martes</option>
                        <option value="MIERCOLES">Miércoles</option>
                        <option value="JUEVES">Jueves</option>
                        <option value="VIERNES">Viernes</option>
                        <option value="SABADO">Sábado</option>
                    </select>
                </div>
                <div class="row">
                    <div class="col-6 mb-3">
                        <label class="form-label fw-bold">Hora Inicio</label>
                        <input type="time" class="form-control" @bind="nuevoHorario.HoraInicio" />
                    </div>
                    <div class="col-6 mb-3">
                        <label class="form-label fw-bold">Hora Fin</label>
                        <input type="time" class="form-control" @bind="nuevoHorario.HoraFin" />
                    </div>
                </div>
                <button class="btn btn-success w-100 fw-bold mt-2" @onclick="GuardarHorario" disabled="@cargando">
                    @(cargando ? "Guardando..." : "Guardar Horario")
                </button>
            </div>
        </div>
    </div>

    <!-- Tabla con horarios registrados -->
    <div class="col-lg-8">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-primary text-white">
                <h5 class="card-title m-0 fw-bold">Horarios Asignados</h5>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-striped table-hover align-middle mb-0">
                        <thead class="bg-light">
                            <tr>
                                <th>Veterinario</th>
                                <th>Día</th>
                                <th>Horario</th>
                                <th>Estado</th>
                                <th class="text-center">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (listaEmpleados == null)
                            {
                                <tr>
                                    <td colspan="5" class="text-center py-3">Cargando datos...</td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var emp in listaEmpleados)
                                {
                                    if (horariosPorEmpleado.ContainsKey(emp.Id.GetValueOrDefault()))
                                    {
                                        var horariosDelEmp = horariosPorEmpleado[emp.Id.GetValueOrDefault()];
                                        
                                        foreach (var hor in horariosDelEmp)
                                        {
                                            <tr>
                                                <td>@(emp.EsAdmin ? "" : "Dr/a.") @emp.Nombres @emp.Apellidos</td>
                                                <td>@hor.DiaSemana</td>
                                                <td>@hor.HoraInicio - @hor.HoraFin</td>
                                                <td>
                                                    @if (hor.Activo)
                                                    {
                                                        <span class="badge bg-success">Activo</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-danger">Inactivo</span>
                                                    }
                                                </td>
                                                <td class="text-center">
                                                    <button class="btn btn-sm btn-danger fw-bold" @onclick="() => EliminarHorario(hor.Id)">Eliminar</button>
                                                </td>
                                            </tr>
                                        }
                                    }
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private HorarioRequest nuevoHorario = new HorarioRequest { DiaSemana = "LUNES" };
    private List<EmpleadoRequest>? listaEmpleados;
    
    // Diccionario para almacenar los horarios de cada empleado sin saturar la red
    private Dictionary<int, List<HorarioRequest>> horariosPorEmpleado = new Dictionary<int, List<HorarioRequest>>();
    
    private string? mensajeAlerta;
    private bool cargando = false;

    protected override async Task OnInitializedAsync()
    {
        await CargarDatosGenerales();
    }

    private async Task CargarDatosGenerales()
