@page "/horarios"

<div class="mb-4">
    <h3 class="m-0 text-dark fw-bold">Gestión de Horarios del Personal</h3>
</div>

<div class="row g-4">
    <!-- Formulario para asignar horario -->
    <div class="col-lg-4">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-primary text-white">
                <h5 class="card-title m-0 fw-bold">Asignar Horario</h5>
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <label class="form-label fw-bold">Veterinario</label>
                    <select class="form-select">
                        <option>Seleccione un veterinario...</option>
                        <option>Dr. Carlos Mendoza</option>
                        <option>Dra. Elena Rojas</option>
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold">Día de la semana</label>
                    <select class="form-select">
                        <option value="1">Lunes</option>
                        <option value="2">Martes</option>
                        <option value="3">Miércoles</option>
                        <option value="4">Jueves</option>
                        <option value="5">Viernes</option>
                        <option value="6">Sábado</option>
                    </select>
                </div>
                <div class="row">
                    <div class="col-6 mb-3">
                        <label class="form-label fw-bold">Hora Inicio</label>
                        <input type="time" class="form-control" />
                    </div>
                    <div class="col-6 mb-3">
                        <label class="form-label fw-bold">Hora Fin</label>
                        <input type="time" class="form-control" />
                    </div>
                </div>
                <button class="btn btn-success w-100 fw-bold mt-2">Guardar Horario</button>
            </div>
        </div>
    </div>

    <!-- Tabla con horarios registrados -->
    <div class="col-lg-8">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-primary text-white">
                <h5 class="card-title m-0 fw-bold">Horarios Asignados</h5>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-striped table-hover align-middle mb-0">
                        <thead class="bg-light">
                            <tr>
                                <th>Veterinario</th>
                                <th>Día</th>
                                <th>Horario</th>
                                <th>Estado</th>
                                <th class="text-center">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>Dr. Carlos Cabrera</td>
                                <td>Lunes</td>
                                <td>08:00 - 14:00</td>
                                <td><span class="badge bg-success">Activo</span></td>
                                <td class="text-center">
                                    <button class="btn btn-sm btn-danger fw-bold">Eliminar</button>
                                </td>
                            </tr>
                            <tr>
                                <td>Dr. Carlos Cabrera</td>
                                <td>Miércoles</td>
                                <td>08:00 - 14:00</td>
                                <td><span class="badge bg-success">Activo</span></td>
                                <td class="text-center">
                                    <button class="btn btn-sm btn-danger fw-bold">Eliminar</button>
                                </td>
                            </tr>
                            <tr>
                                <td>Dra. Elena Rojas</td>
                                <td>Martes</td>
                                <td>14:00 - 20:00</td>
                                <td><span class="badge bg-success">Activo</span></td>
                                <td class="text-center">
                                    <button class="btn btn-sm btn-danger fw-bold">Eliminar</button>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>