@page "/veterinario/citas"
@rendermode InteractiveServer
@inject VeterinariaMockDataService MockData
@inject NavigationManager Navigation

<div class="container-fluid px-0">
    <!-- Encabezado con información del veterinario -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
        <div>
            <h3 class="m-0 text-dark fw-bold">
                <i class="bi bi-calendar-check text-primary me-2"></i>Citas Médicas Asignadas
            </h3>
            <div class="text-muted small mt-1">
                <span class="badge bg-primary me-2"><i class="bi bi-person-badge me-1"></i>@MockData.VeterinarioActual</span>
                <span class="badge bg-secondary me-2"><i class="bi bi-award me-1"></i>@MockData.CmvpActual</span>
                <span class="badge bg-light text-dark border"><i class="bi bi-geo-alt me-1"></i>@MockData.SedeActual</span>
            </div>
        </div>
        <div class="d-flex gap-2">
            <a href="/veterinario/historial" class="btn btn-outline-primary">
                <i class="bi bi-journal-medical me-1"></i> Historial Clínico
            </a>
            <a href="/veterinario/atenciones/nueva" class="btn btn-success fw-bold">
                <i class="bi bi-clipboard2-pulse me-1"></i> Nueva Atención
            </a>
        </div>
    </div>

    <!-- Tarjetas Métricas / Resumen rápido de Citas -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <div class="card shadow-sm border-0 border-start border-primary border-4 h-100">
                <div class="card-body py-2">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <span class="text-muted small text-uppercase fw-bold">Total Asignadas</span>
                            <h4 class="fw-bold mb-0 text-primary">@TotalCitas</h4>
                        </div>
                        <i class="bi bi-calendar-event fs-2 text-primary opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card shadow-sm border-0 border-start border-warning border-4 h-100">
                <div class="card-body py-2">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <span class="text-muted small text-uppercase fw-bold">Por Atender</span>
                            <h4 class="fw-bold mb-0 text-warning">@CitasPendientes</h4>
                        </div>
                        <i class="bi bi-hourglass-split fs-2 text-warning opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card shadow-sm border-0 border-start border-success border-4 h-100">
                <div class="card-body py-2">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <span class="text-muted small text-uppercase fw-bold">Atendidas</span>
                            <h4 class="fw-bold mb-0 text-success">@CitasAtendidas</h4>
                        </div>
                        <i class="bi bi-check2-circle fs-2 text-success opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card shadow-sm border-0 border-start border-danger border-4 h-100">
                <div class="card-body py-2">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <span class="text-muted small text-uppercase fw-bold">Canceladas</span>
                            <h4 class="fw-bold mb-0 text-danger">@CitasCanceladas</h4>
                        </div>
                        <i class="bi bi-x-circle fs-2 text-danger opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Barra de Filtros Interactivas -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-primary text-white py-2">
            <div class="d-flex justify-content-between align-items-center">
                <h6 class="m-0 fw-bold"><i class="bi bi-funnel-fill me-1"></i> Filtros de Búsqueda</h6>
                @if (FiltrosActivos)
                {
                    <button class="btn btn-sm btn-light py-0 text-primary fw-bold" @onclick="LimpiarFiltros">
                        <i class="bi bi-x-lg"></i> Limpiar Filtros
                    </button>
                }
            </div>
        </div>
        <div class="card-body bg-light">
            <div class="row g-3 align-items-end">
                <!-- Filtro por Texto / Búsqueda -->
                <div class="col-lg-4 col-md-6">
                    <label class="form-label fw-bold small text-secondary mb-1">Buscar Mascota o Dueño</label>
                    <div class="input-group">
                        <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                        <input type="text" class="form-control" placeholder="Ej: Firulais, Juan, etc."
                               @bind="textoBusqueda" @bind:event="oninput" />
                    </div>
                </div>

                <!-- Filtro por Estado -->
                <div class="col-lg-3 col-md-6">
                    <label class="form-label fw-bold small text-secondary mb-1">Estado de Cita</label>
                    <select class="form-select" @bind="filtroEstado">
                        <option value="">-- Todos los estados --</option>
                        <option value="PROGRAMADA">PROGRAMADA</option>
                        <option value="CONFIRMADA">CONFIRMADA</option>
                        <option value="ATENDIDA">ATENDIDA</option>
                        <option value="CANCELADA">CANCELADA</option>
                        <option value="NO_ASISTIO">NO ASISTIÓ</option>
                    </select>
                </div>

                <!-- Filtro por Fecha Rápida / Selector -->
                <div class="col-lg-3 col-md-8">
                    <label class="form-label fw-bold small text-secondary mb-1">Filtro por Fecha</label>
                    <div class="btn-group w-100" role="group">
                        <button type="button" class="btn btn-outline-secondary btn-sm @(filtroFechaRapido == "TODAS" ? "active" : "")"
                                @onclick="@(() => SeleccionarFiltroFecha("TODAS"))">
                            Todas
                        </button>
                        <button type="button" class="btn btn-outline-primary btn-sm @(filtroFechaRapido == "HOY" ? "active" : "")"
                                @onclick="@(() => SeleccionarFiltroFecha("HOY"))">
                            Hoy
                        </button>
                        <button type="button" class="btn btn-outline-secondary btn-sm @(filtroFechaRapido == "MANANA" ? "active" : "")"
                                @onclick="@(() => SeleccionarFiltroFecha("MANANA"))">
                            Mañana
                        </button>
                    </div>
                </div>

                <div class="col-lg-2 col-md-4">
                    <label class="form-label fw-bold small text-secondary mb-1">Fecha Específica</label>
                    <input type="date" class="form-control form-control-sm" @bind="fechaEspecifica" />
                </div>
            </div>
        </div>
    </div>

    <!-- Tabla de Citas Asignadas -->
    <div class="card shadow-sm border-0">
        <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center border-bottom">
            <h5 class="card-title m-0 fw-bold text-dark">
                <i class="bi bi-list-task me-2 text-primary"></i>Agenda de Citas (@CitasFiltradas.Count)
            </h5>
            <span class="badge bg-light text-muted border">Mostrando citas filtradas</span>
        </div>
        <div class="card-body p-0">
            @if (CitasFiltradas.Count == 0)
            {
                <div class="p-5 text-center">
                    <i class="bi bi-calendar-x text-muted" style="font-size: 3rem;"></i>
                    <h5 class="mt-3 text-secondary">No se encontraron citas</h5>
                    <p class="text-muted small">No hay citas asignadas que coincidan con los filtros seleccionados.</p>
                    <button class="btn btn-sm btn-outline-primary" @onclick="LimpiarFiltros">
                        Restablecer Filtros
                    </button>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th style="width: 140px;">Horario</th>
                                <th>Paciente / Mascota</th>
                                <th>Propietario</th>
                                <th>Servicio y Motivo</th>
                                <th class="text-center" style="width: 130px;">Estado</th>
                                <th class="text-end" style="width: 220px;">Acciones Clínicas</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var cita in CitasFiltradas)
                            {
                                bool esHoy = cita.FechaHoraInicio.Date == DateTime.Today;
                                <tr>
                                    <td>
                                        <div class="fw-bold text-dark">
                                            @cita.FechaHoraInicio.ToString("dd/MM/yyyy")
                                        </div>
                                        <div class="text-muted small">
                                            <i class="bi bi-clock me-1"></i>@cita.FechaHoraInicio.ToString("HH:mm") - @cita.FechaHoraFin.ToString("HH:mm")
                                        </div>
                                        @if (esHoy)
                                        {
                                            <span class="badge bg-primary-subtle text-primary border border-primary mt-1" style="font-size: 0.7rem;">HOY</span>
                                        }
                                    </td>
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <span class="badge @(cita.EspecieMascota == "CANINO" ? "bg-info text-dark" : "bg-warning text-dark") rounded-circle p-2">
                                                <i class="bi @(cita.EspecieMascota == "CANINO" ? "bi-award" : "bi-stars")"></i>
                                            </span>
                                            <div>
                                                <span class="fw-bold text-dark">@cita.NombreMascota</span>
                                                <div class="text-muted small">
                                                    @cita.EspecieMascota • @cita.RazaMascota • @cita.SexoMascota
                                                </div>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="fw-semibold text-dark">@cita.NombreCliente</div>
                                        <div class="text-muted small">
                                            <i class="bi bi-telephone me-1"></i>@cita.TelefonoCliente
                                        </div>
                                    </td>
                                    <td>
                                        <span class="badge bg-secondary mb-1">@cita.ServicioSolicitado</span>
                                        <div class="text-muted small text-truncate" style="max-width: 280px;" title="@cita.Motivo">
                                            @cita.Motivo
                                        </div>
                                    </td>
                                    <td class="text-center">
                                        @switch (cita.Estado)
                                        {
                                            case "PROGRAMADA":
                                                <span class="badge bg-warning text-dark px-2 py-1"><i class="bi bi-clock me-1"></i>Programada</span>
                                                break;
                                            case "CONFIRMADA":
                                                <span class="badge bg-info text-dark px-2 py-1"><i class="bi bi-check-circle me-1"></i>Confirmada</span>
                                                break;
                                            case "ATENDIDA":
                                                <span class="badge bg-success text-white px-2 py-1"><i class="bi bi-check-all me-1"></i>Atendida</span>
                                                break;
                                            case "CANCELADA":
                                                <span class="badge bg-danger text-white px-2 py-1"><i class="bi bi-x-circle me-1"></i>Cancelada</span>
                                                break;
                                            case "NO_ASISTIO":
                                                <span class="badge bg-secondary text-white px-2 py-1"><i class="bi bi-person-x me-1"></i>No asistió</span>
                                                break;
                                            default:
                                                <span class="badge bg-light text-dark">@cita.Estado</span>
                                                break;
                                        }
                                    </td>
                                    <td class="text-end">
                                        <div class="d-flex justify-content-end gap-1 flex-wrap">
                                            @if (cita.Estado != "ATENDIDA" && cita.Estado != "CANCELADA")
                                            {
                                                <a href="/veterinario/atenciones/nueva?citaId=@cita.CitaId&mascotaId=@cita.MascotaId"
                                                   class="btn btn-sm btn-success fw-bold"
                                                   title="Registrar Atención Clínica">
                                                    <i class="bi bi-clipboard2-pulse me-1"></i> Atender
                                                </a>
                                            }

                                            <a href="/veterinario/historial/@cita.MascotaId"
                                               class="btn btn-sm btn-outline-primary"
                                               title="Ver Historial Clínico de la Mascota">
                                                <i class="bi bi-journal-medical"></i> Historial
                                            </a>

                                            <!-- Opciones rápidas de estado -->
                                            <div class="btn-group">
                                                <button type="button" class="btn btn-sm btn-light border dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
                                                    <i class="bi bi-three-dots-vertical"></i>
                                                </button>
                                                <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                                                    <li><h6 class="dropdown-header">Cambiar Estado</h6></li>
                                                    @if (cita.Estado != "CONFIRMADA" && cita.Estado != "ATENDIDA")
                                                    {
                                                        <li>
                                                            <button class="dropdown-item small" @onclick="@(() => CambiarEstado(cita.CitaId, "CONFIRMADA"))">
                                                                <i class="bi bi-check-circle text-info me-2"></i>Marcar Confirmada
                                                            </button>
                                                        </li>
                                                    }
                                                    @if (cita.Estado != "NO_ASISTIO" && cita.Estado != "ATENDIDA")
                                                    {
                                                        <li>
                                                            <button class="dropdown-item small" @onclick="@(() => CambiarEstado(cita.CitaId, "NO_ASISTIO"))">
                                                                <i class="bi bi-person-x text-secondary me-2"></i>Marcar No Asistió
                                                            </button>
                                                        </li>
                                                    }
                                                    @if (cita.Estado != "CANCELADA" && cita.Estado != "ATENDIDA")
                                                    {
                                                        <li>
                                                            <button class="dropdown-item small text-danger" @onclick="@(() => CambiarEstado(cita.CitaId, "CANCELADA"))">
                                                                <i class="bi bi-x-circle me-2"></i>Cancelar Cita
                                                            </button>
                                                        </li>
                                                    }
                                                </ul>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
        <div class="card-footer bg-light py-2 text-muted small d-flex justify-content-between align-items-center">
            <span>Operación clínica: Personal veterinario en sede.</span>
            <span>Clínica Veterinaria Mimados • Sistema Web</span>
        </div>
    </div>
</div>

@code {
    private string textoBusqueda = "";
    private string filtroEstado = "";
    private string filtroFechaRapido = "TODAS";
    private DateTime? fechaEspecifica;

    private int TotalCitas => MockData.GetCitas().Count;
    private int CitasPendientes => MockData.GetCitas().Count(c => c.Estado == "PROGRAMADA" || c.Estado == "CONFIRMADA");
    private int CitasAtendidas => MockData.GetCitas().Count(c => c.Estado == "ATENDIDA");
    private int CitasCanceladas => MockData.GetCitas().Count(c => c.Estado == "CANCELADA" || c.Estado == "NO_ASISTIO");

    private bool FiltrosActivos =>
        !string.IsNullOrWhiteSpace(textoBusqueda) ||
        !string.IsNullOrWhiteSpace(filtroEstado) ||
        filtroFechaRapido != "TODAS" ||
        fechaEspecifica.HasValue;

    private List<Cita> CitasFiltradas
    {
        get
        {
            var citas = MockData.GetCitas().AsEnumerable();

            // Filtro por texto (mascota, cliente, motivo)
            if (!string.IsNullOrWhiteSpace(textoBusqueda))
            {
                var q = textoBusqueda.Trim().ToLower();
                citas = citas.Where(c =>
                    c.NombreMascota.ToLower().Contains(q) ||
                    c.NombreCliente.ToLower().Contains(q) ||
                    c.Motivo.ToLower().Contains(q) ||
                    c.RazaMascota.ToLower().Contains(q));
            }

            // Filtro por estado
            if (!string.IsNullOrWhiteSpace(filtroEstado))
            {
                citas = citas.Where(c => c.Estado == filtroEstado);
            }

            // Filtro por fecha rápida
            if (filtroFechaRapido == "HOY")
            {
                citas = citas.Where(c => c.FechaHoraInicio.Date == DateTime.Today);
            }
            else if (filtroFechaRapido == "MANANA")
            {
                citas = citas.Where(c => c.FechaHoraInicio.Date == DateTime.Today.AddDays(1));
            }

            // Filtro por fecha específica
            if (fechaEspecifica.HasValue)
            {
                citas = citas.Where(c => c.FechaHoraInicio.Date == fechaEspecifica.Value.Date);
            }

            return citas.OrderBy(c => c.FechaHoraInicio).ToList();
        }
    }

    private void SeleccionarFiltroFecha(string filtro)
    {
        filtroFechaRapido = filtro;
        fechaEspecifica = null;
    }

    private void LimpiarFiltros()
    {
        textoBusqueda = "";
        filtroEstado = "";
        filtroFechaRapido = "TODAS";
        fechaEspecifica = null;
    }

    private void CambiarEstado(int citaId, string nuevoEstado)
    {
        MockData.CambiarEstadoCita(citaId, nuevoEstado);
    }
}

