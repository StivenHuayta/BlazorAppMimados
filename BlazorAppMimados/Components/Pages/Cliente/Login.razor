@page "/login"
@page "/cliente/login"
@using System.Text.RegularExpressions
@layout Layout.BlankLayout
@rendermode InteractiveServer 
@inject NavigationManager Navigation
@inject CustomAuthenticationStateProvider AuthStateProvider

<div class="d-flex justify-content-center align-items-center vh-100 bg-light">
    <div class="card p-4 shadow border-0 bg-white" style="width: 420px; border-radius: 8px;">
        
        <h3 class="text-center mb-4 fw-bold text-success">
            🐾 Mimados Vet
        </h3>
        
        <!-- Alerta para mostrar mensajes de error -->
        @if (!string.IsNullOrEmpty(mensajeError))
        {
            <div class="alert alert-danger py-2 mb-3 text-center fw-bold small" role="alert">
                @mensajeError
            </div>
        }

        <div>
            <div class="mb-3">
                <label class="form-label fw-bold text-dark">Usuario / Correo</label>
                <input type="text" class="form-control bg-white text-dark" placeholder="atorres@mimados.com" @bind="correo" />
            </div>
            
            <div class="mb-3">
                <label class="form-label fw-bold text-dark">Contraseña</label>
                <input type="password" class="form-control bg-white text-dark" placeholder="Ingrese su contraseña" @bind="contrasena" />
            </div>
            
            <div class="mb-4">
                <label class="form-label fw-bold text-dark">Ingresar como:</label>
                <select class="form-select bg-white text-dark" @bind="rolSeleccionado">
                    <option value="Cliente">Cliente</option>
                    <option value="Administrador">Administrador</option>
                    <option value="Veterinario">Personal Veterinario</option>
                </select>
            </div>
            
            <button type="button" class="btn btn-success w-100 fw-bold py-2" @onclick="IniciarSesion">
                Ingresar al Sistema
            </button>
        </div>

        <div class="mt-3 text-center small text-muted">
            Admin demo: <code>atorres@mimados.com</code> o <code>admin</code> (clave: cualquiera)
        </div>
        
    </div>
</div>

@code {
    private string correo = "atorres@mimados.com";
    private string contrasena = "123456";
    private string rolSeleccionado = "Administrador";
    private string mensajeError = "";

    protected override void OnInitialized()
    {
        // Al entrar a login, cerramos cualquier sesión previa
        AuthStateProvider.Logout();
    }

    private void IniciarSesion()
    {
        mensajeError = "";

        // 1. Validar que los campos no estén vacíos
        if (string.IsNullOrWhiteSpace(correo) || string.IsNullOrWhiteSpace(contrasena))
        {
            mensajeError = "Por favor, complete todos los campos.";
            return;
        }

        // 2. Validar formato de correo o usuario simple "admin"
        string correoLimpio = correo.Trim();
        bool esUsuarioSimple = correoLimpio.Equals("admin", StringComparison.OrdinalIgnoreCase);
        bool correoValido = esUsuarioSimple || Regex.IsMatch(correoLimpio, @"^[^@\s]+@[^@\s]+\.[^@\s]+$");
        if (!correoValido)
        {
            mensajeError = "Por favor, ingrese un formato de correo válido (ej: nombre@dominio.com) o 'admin'.";
            return;
        }

        // 3. Autenticación y redirección según rol seleccionado
        if (rolSeleccionado == "Administrador")
        {
            AuthStateProvider.Login(correoLimpio, "Admin");
            Navigation.NavigateTo("/admin/inicio");
        }
        else if (rolSeleccionado == "Veterinario")
        {
            AuthStateProvider.Login(correoLimpio, "Veterinario");
            Navigation.NavigateTo("/veterinario/citas");
        }
        else
        {
            AuthStateProvider.Login(correoLimpio, "Cliente");
            Navigation.NavigateTo("/cliente/mascotas");
        }
    }
}
}