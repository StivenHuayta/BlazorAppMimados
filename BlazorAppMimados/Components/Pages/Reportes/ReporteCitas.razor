@page "/reportes/citas"

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="m-0 text-dark fw-bold">Reporte de Citas</h3>
</div>

<!-- Filtros del Reporte -->
<div class="card shadow-sm border-0 mb-4">
    <div class="card-header bg-info text-white">
        <h5 class="card-title m-0 fw-bold">Filtros de Búsqueda</h5>
    </div>
    <div class="card-body bg-light">
        <form class="row align-items-end g-3">
            <div class="col-md-3">
                <label class="form-label fw-bold">Fecha Inicio</label>
                <input type="date" class="form-control" />
            </div>
            <div class="col-md-3">
                <label class="form-label fw-bold">Fecha Fin</label>
                <input type="date" class="form-control" />
            </div>
            <div class="col-md-4">
                <label class="form-label fw-bold">Estado de Cita</label>
                <select class="form-select">
                    <option value="">-- Todos los estados --</option>
                    <option value="Programada">Programada</option>
                    <option value="Completada">Completada</option>
                    <option value="Cancelada">Cancelada</option>
                </select>
            </div>
            <div class="col-md-2">
                <button type="button" class="btn btn-primary w-100 fw-bold">Generar Reporte</button>
            </div>
        </form>
    </div>
</div>

<!-- Resultados del Reporte -->
<div class="card shadow-sm border-0">
    <div class="card-header bg-primary text-white">
        <h5 class="card-title m-0 fw-bold">Listado de Citas Encontradas</h5>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-striped table-bordered align-middle mb-0">
                <thead class="bg-light">
                    <tr>
                        <th>ID Cita</th>
                        <th>Fecha y Hora</th>
                        <th>Sede</th>
                        <th>Mascota</th>
                        <th>Veterinario</th>
                        <th>Motivo</th>
                        <th>Estado</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>#10024</td>
                        <td>12/10/2026 09:30</td>
                        <td>Sede Central</td>
                        <td>Firulais (Mestizo)</td>
                        <td>Dr. Carlos Mendoza</td>
                        <td>Control general</td>
                        <td><span class="badge bg-success">Completada</span></td>
                    </tr>
                    <tr>
                        <td>#10025</td>
                        <td>12/10/2026 11:00</td>
                        <td>Sede Central</td>
                        <td>Michi (Siamés)</td>
                        <td>Dra. Elena Rojas</td>
                        <td>Vacunación</td>
                        <td><span class="badge bg-warning text-dark">Programada</span></td>
                    </tr>
                    <tr>
                        <td>#10026</td>
                        <td>14/10/2026 15:00</td>
                        <td>Sede Norte</td>
                        <td>Max (Pug)</td>
                        <td>Dr. Carlos Mendoza</td>
                        <td>Consulta médica</td>
                        <td><span class="badge bg-danger">Cancelada</span></td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>