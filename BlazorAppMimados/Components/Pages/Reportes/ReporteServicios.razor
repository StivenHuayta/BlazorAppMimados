@page "/reporte/servicios"




<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-graph-up-arrow me-2"></i>Reporte de Servicios Más Solicitados</h2>

        <button class="btn btn-success" @onclick="ExportarPDF">
            <i class="bi bi-file-earmark-pdf"></i> Exportar PDF
        </button>
    </div>


    <div class="card shadow-sm mb-4 border-0">
    <div class="card-body">
        
        <!-- Fila 1: Título -->
        <div class="row mb-3">
            <div class="col-12">
                <h5 class="card-title fw-bold text-secondary mb-0">Filtros de Búsqueda</h5>
            </div>
        </div>
        
        <!-- Fila 2: Fechas (Desde y Hasta lado a lado) -->
        <div class="row g-3 mb-3">
            <div class="col-md-6">
                <label class="form-label text-muted small fw-bold">Fecha Desde</label>
                <input type="date" class="form-control form-control-sm " @bind="filtroFechaInicio" />
            </div>
            <div class="col-md-6">
                <label class="form-label text-muted small fw-bold">Fecha Hasta</label>
                <input type="date" class="form-control form-control-sm " @bind="filtroFechaFin" />
            </div>
        </div>

        <!-- Fila 3: Botones  -->
        <div class="row">
           <div class="col-md-12 d-flex align-items-end gap-2">
                    <button class="btn btn-primary btn-sm px-4 shadow-sm" @onclick="AplicarFiltros">
                        <i class="bi bi-search me-1"></i>Buscar
                    </button>
                    <button class="btn btn-outline-secondary btn-sm px-4" @onclick="LimpiarFiltros">
                        <i class="bi bi-x-circle me-1"></i>Limpiar
                    </button>
                </div>
        </div>

    </div>
</div>

    <!-- Tabla de servicios solicitados -->
    <div class="card shadow-sm">
        <div class="card-body">
            <table class="table table-hover align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>#</th>
                        <th>Nombre del Servicio</th>
                        <th>Total Solicitudes</th>
                        <th>Precio Unitario</th>
                        <th>Ingresos Totales</th>
                        <th>Estado</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var (index, servicio) in serviciosPopulares.Select((s, i) => (i + 1, s)))
                    {
                        <tr>
                            <td>@index</td>
                            <td><strong>@servicio.Nombre</strong></td>
                            <td><span class="badge bg-primary fs-6">@servicio.Cantidad solicitudes</span></td>
                            <td>@servicio.Precio.ToString("C2")</td>
                            <td>@servicio.Ingreso.ToString("C2")</td>
                            
                            <td>
                                <span class="text-success fw-bold">● Alta Demanda</span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@code {

    private DateTime filtroFechaInicio = DateTime.Today.AddMonths(-1);
    private DateTime filtroFechaFin = DateTime.Today;
    private string filtroSede = "";

    private void AplicarFiltros()
    {
        Console.WriteLine("Filtrando Ando");
    }

    private void LimpiarFiltros()
    {
        filtroFechaInicio = DateTime.Today.AddMonths(-1);
        filtroFechaFin = DateTime.Today;
        filtroSede = "";
    }
    private class ServicioReporte
    {
        public string Nombre { get; set; } = "";
        public double Precio { get; set; } = 0.0;
        public int Cantidad { get; set; }
        public double Ingreso { get; set; } = 0.0;

    }

    private List<ServicioReporte> serviciosPopulares = new()
    {
        new ServicioReporte { Nombre = "Baño y Corte de Pelo", Precio = 50.0, Cantidad = 120 , Ingreso = 6000},
        new ServicioReporte { Nombre = "Consulta Veterinaria General", Precio = 70.0, Cantidad = 95 , Ingreso = 6650},
        new ServicioReporte { Nombre = "Vacunación Antirrábica", Precio = 120.0, Cantidad = 60 , Ingreso = 7200},
    };

    private void ExportarPDF()
    {
        Console.WriteLine("Exportando Ando");
    }
}