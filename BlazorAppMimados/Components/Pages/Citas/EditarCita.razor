@page "/cliente/citas/editar/{Id:int}"
@rendermode InteractiveServer

<PageTitle>Editar Cita - Mimados</PageTitle>

<div class="container mt-4" style="max-width: 800px;">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
        <h2 class="mb-0">Modificar Cita</h2>
        <a class="btn btn-secondary" href="@($"/cliente/citas/detalle/{Id}")"><i class="bi bi-arrow-left me-1"></i> Volver al detalle</a>
    </div>

    @if (CitaNoEncontrada)
    {
        <div class="alert alert-warning" role="alert">No se encontró la cita solicitada.</div>
    }
    else
    {
        <div class="card p-4 shadow-sm border-0 bg-light">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                <h5 class="fw-bold mb-0"><i class="bi bi-pencil-square text-success me-2"></i>Editar datos de la cita @Codigo</h5>
                <span class="badge @(Id == 2 ? "bg-warning text-dark" : "bg-success")">@(Id == 2 ? "Pendiente" : "Confirmada")</span>
            </div>
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label for="editar-mascota" class="form-label fw-bold">Mascota:</label>
                    <select id="editar-mascota" class="form-select" @bind="mascota">
                        <option value="Firulais">Firulais</option>
                        <option value="Michi">Michi</option>
                    </select>
                </div>
                <div class="col-md-6 mb-3">
                    <label for="editar-sede" class="form-label fw-bold">Sede:</label>
                    <select id="editar-sede" class="form-select" @bind="sede">
                        <option value="San Miguel">San Miguel</option>
                        <option value="Surco">Surco</option>
                    </select>
                </div>
                <div class="col-md-6 mb-3">
                    <label for="editar-servicio" class="form-label fw-bold">Servicio:</label>
                    <select id="editar-servicio" class="form-select" @bind="servicio">
                        <option value="Consulta general">Consulta general</option>
                        <option value="Vacunación">Vacunación</option>
                        <option value="Control veterinario">Control veterinario</option>
                    </select>
                </div>
                <div class="col-md-6 mb-3">
                    <label for="editar-veterinario" class="form-label fw-bold">Veterinario:</label>
                    <select id="editar-veterinario" class="form-select" @bind="veterinario">
                        <option value="Dra. Ana Torres">Dra. Ana Torres</option>
                        <option value="Dr. Luis Ramírez">Dr. Luis Ramírez</option>
                    </select>
                </div>
                <div class="col-md-6 mb-3">
                    <label for="editar-fecha" class="form-label fw-bold">Fecha de la cita:</label>
                    <input id="editar-fecha" class="form-control" type="date" @bind="fecha" />
                </div>
                <div class="col-md-6 mb-3">
                    <label for="editar-hora" class="form-label fw-bold">Horario:</label>
                    <select id="editar-hora" class="form-select" @bind="hora">
                        <option value="09:00">09:00 a. m.</option>
                        <option value="10:00">10:00 a. m.</option>
                        <option value="11:30">11:30 a. m.</option>
                        <option value="15:30">03:30 p. m.</option>
                    </select>
                </div>
            </div>
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mt-2">
                <a href="/cliente/citas/disponibilidad" class="btn btn-outline-primary">Ver disponibilidad</a>
                <button type="button" class="btn btn-warning fw-bold px-4" @onclick="GuardarCambios"><i class="bi bi-pencil-square me-1"></i> Guardar Cambios</button>
            </div>
            @if (cambiosGuardados)
            {
                <div class="alert alert-success mt-3 mb-0" role="status">Cambios guardados correctamente. <a class="alert-link" href="/cliente/citas">Volver a Mis Citas</a></div>
            }
        </div>
    }
</div>

@code {
    [Parameter] public int Id { get; set; }

    private string Codigo => $"C-{Id:000}";
    private bool CitaNoEncontrada => Id != 1 && Id != 2;
    private bool cambiosGuardados;

    private string mascota = "";
    private string sede = "";
    private string servicio = "";
    private string veterinario = "";
    private DateTime? fecha;
    private string hora = "";

    protected override void OnParametersSet()
    {
        // Los campos muestran los valores de la reserva seleccionada.
        cambiosGuardados = false;
        if (Id == 1)
        {
            mascota = "Firulais";
            sede = "San Miguel";
            servicio = "Consulta general";
            veterinario = "Dra. Ana Torres";
            fecha = new DateTime(2026, 11, 4);
            hora = "10:00";
        }
        else if (Id == 2)
        {
            mascota = "Michi";
            sede = "Surco";
            servicio = "Vacunación";
            veterinario = "Dr. Luis Ramírez";
            fecha = new DateTime(2026, 11, 7);
            hora = "15:30";
        }
    }

    private void GuardarCambios() => cambiosGuardados = true;
}
