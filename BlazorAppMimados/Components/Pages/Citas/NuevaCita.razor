@page "/cliente/citas/nueva"
@rendermode InteractiveServer

<PageTitle>Reservar Cita - Mimados</PageTitle>

<div class="container mt-4" style="max-width: 920px;">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
        <div>
            <h2 class="mb-1">Reservar Cita</h2>
            <p class="text-muted mb-0">Completa los datos para solicitar una atención para tu mascota.</p>
        </div>
        <a class="btn btn-secondary" href="/cliente/citas">
            <i class="bi bi-arrow-left me-1"></i> Volver a Mis Citas
        </a>
    </div>

    <div class="card p-4 shadow-sm border-0 bg-light">
        <h5 class="fw-bold mb-3"><i class="bi bi-calendar-plus text-success me-2"></i>Datos de la reserva</h5>
        <div class="row">
            <div class="col-md-6 mb-3">
                <label for="cita-mascota" class="form-label fw-bold">Mascota:</label>
                <select id="cita-mascota" class="form-select">
                    <option value="">-- Seleccione --</option>
                    <option>Firulais</option>
                    <option>Michi</option>
                </select>
            </div>
            <div class="col-md-6 mb-3">
                <label for="cita-sede" class="form-label fw-bold">Sede:</label>
                <select id="cita-sede" class="form-select">
                    <option value="">-- Seleccione --</option>
                    <option>San Miguel</option>
                    <option>Surco</option>
                </select>
            </div>
            <div class="col-md-6 mb-3">
                <label for="cita-servicio" class="form-label fw-bold">Servicio:</label>
                <select id="cita-servicio" class="form-select">
                    <option value="">-- Seleccione --</option>
                    <option>Consulta general</option>
                    <option>Vacunación</option>
                    <option>Control veterinario</option>
                </select>
            </div>
            <div class="col-md-6 mb-3">
                <label for="cita-especialidad" class="form-label fw-bold">Especialidad:</label>
                <select id="cita-especialidad" class="form-select">
                    <option value="">-- Seleccione --</option>
                    <option>Medicina general</option>
                    <option>Medicina preventiva</option>
                </select>
            </div>
            <div class="col-md-6 mb-3">
                <label for="cita-fecha" class="form-label fw-bold">Fecha:</label>
                <input id="cita-fecha" type="date" class="form-control" />
            </div>
            <div class="col-md-6 mb-3">
                <label for="cita-hora" class="form-label fw-bold">Horario:</label>
                <select id="cita-hora" class="form-select">
                    <option value="">-- Seleccione --</option>
                    <option>09:00 a. m.</option>
                    <option>10:00 a. m.</option>
                    <option>11:30 a. m.</option>
                    <option>03:30 p. m.</option>
                </select>
            </div>
            <div class="col-12 mb-3">
                <label for="cita-veterinario" class="form-label fw-bold">Veterinario de preferencia:</label>
                <select id="cita-veterinario" class="form-select">
                    <option value="">-- Seleccione --</option>
                    <option>Dra. Ana Torres</option>
                    <option>Dr. Luis Ramírez</option>
                </select>
                
            </div>
            <div class="col-12 mb-4">
                <label for="cita-observaciones" class="form-label fw-bold">Observaciones (opcional):</label>
                <textarea id="cita-observaciones" class="form-control" rows="3" placeholder="Motivo de la visita o indicaciones adicionales"></textarea>
            </div>
        </div>
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
            <a class="btn btn-outline-primary" href="/cliente/citas/disponibilidad">
                <i class="bi bi-search me-1"></i> Consultar Disponibilidad
            </a>
            <button type="button" class="btn btn-success px-4" @onclick="ConfirmarReserva">
                <i class="bi bi-check-circle me-1"></i> Reservar Cita
            </button>
        </div>
        @if (reservaConfirmada)
        {
            <div class="alert alert-success mt-3 mb-0" role="status">
                <i class="bi bi-check-circle me-1"></i> Cita reservada correctamente.
                <a href="/cliente/citas" class="alert-link ms-1">Ver mis citas</a>
            </div>
        }
    </div>
</div>

@code {
    private bool reservaConfirmada;
    private void ConfirmarReserva() => reservaConfirmada = true;
}
