@page "/cliente/citas/nueva"
@rendermode InteractiveServer

@using System.Globalization
@using Microsoft.AspNetCore.Components
@using Mimados_WebApp.Models
@using Mimados_WebApp.Services
@using Mimados_WebApp.Services.CitaServices

@inject ICitaService CitaService
@inject IVeterinarioService VeterinarioService
@inject IDisponibilidadService DisponibilidadService

<PageTitle>Reservar Cita - Mimados</PageTitle>

<div class="container mt-4" style="max-width: 920px;">

    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
        <div>
            <h2 class="mb-1">Reservar Cita</h2>
            <p class="text-muted mb-0">
                Completa los datos para reservar una atención.
            </p>
        </div>

        <a class="btn btn-secondary" href="/cliente/citas">
            Volver a Mis Citas
        </a>
    </div>

    <div class="card p-4 shadow-sm border-0 bg-light">

        <h5 class="fw-bold mb-3">
            <i class="bi bi-calendar-plus text-success me-2"></i>
            Datos de la reserva
        </h5>

        @if (cargandoVeterinarios)
        {
            <div class="alert alert-info">
                Cargando veterinarios...
            </div>
        }

        <div class="row">

            <!-- Mascota temporal -->
            <div class="col-md-6 mb-3">
                <label class="form-label fw-bold">
                    Mascota:
                </label>

                <select class="form-select" @bind="mascotaId">
                    <option value="0">-- Seleccione --</option>
                    <option value="1">Mascota de prueba (ID 1)</option>
                </select>
            </div>

            <!-- Veterinarios reales -->
            <div class="col-md-6 mb-3">
                <label class="form-label fw-bold">
                    Veterinario:
                </label>

                <select class="form-select"
                        @bind="empleadoId"
                        disabled="@cargandoVeterinarios">

                    <option value="0">
                        -- Seleccione un veterinario --
                    </option>

                    @foreach (var veterinario in veterinarios)
                    {
                        <option value="@veterinario.EmpleadoId">
                            @veterinario.Nombre - @veterinario.Sede
                        </option>
                    }
                </select>
            </div>

            <!-- Fecha -->
            <div class="col-md-6 mb-3">
                <label class="form-label fw-bold">
                    Fecha:
                </label>

                <input type="date"
                       class="form-control"
                       min="@DateTime.Today.ToString("yyyy-MM-dd")"
                       @bind="fecha" />
            </div>

            <!-- Hora -->
            
            <div class="row">
                <div class="col-6">
                    <label class="form-label">Hora (24 h):</label>
                    <select class="form-select" @bind="Hora24">
                        @for (int i = 0; i < 24; i++)
                        {
                            <option value="@i">@($"{i:00}")</option>
                        }
                    </select>
                </div>

                <div class="col-6">
                    <label class="form-label">Minutos:</label>
                    <select class="form-select" @bind="Minuto">
                        @for (int i = 0; i < 60; i += 5)
                        {
                            <option value="@i">@($"{i:00}")</option>
                        }
                    </select>
                </div>
            </div>

            <small class="text-muted">
                Hora seleccionada (24 h):
                @(hora?.ToString("HH:mm") ?? "--:--")
            </small>


            <!-- Duracion -->
            <div class="col-md-6 mb-3">
                <label class="form-label fw-bold">
                    Duración de la cita:
                </label>

                <select class="form-select" @bind="duracionMinutos">
                    <option value="30">30 minutos</option>
                    <option value="45">45 minutos</option>
                    <option value="60">60 minutos</option>
                </select>
            </div>

            <!-- Motivo -->
            <div class="col-12 mb-4">
                <label class="form-label fw-bold">
                    Motivo de la cita:
                </label>

                <textarea class="form-control"
                          rows="3"
                          maxlength="255"
                          @bind="motivo"
                          placeholder="Motivo de la visita"></textarea>
            </div>

        </div>

        <div class="d-flex flex-wrap justify-content-between gap-2">

            <a class="btn btn-outline-primary"
               href="/cliente/citas/disponibilidad">
                <i class="bi bi-search me-1"></i>
                Consultar Disponibilidad
            </a>

            <button type="button"
                    class="btn btn-success px-4"
                    disabled="@(procesando || reservaConfirmada || cargandoVeterinarios)"
                    @onclick="ConfirmarReserva">

                @(procesando ? "Registrando..." : "Reservar Cita")
            </button>
        </div>

        @if (!string.IsNullOrEmpty(mensajeError))
        {
            <div class="alert alert-danger mt-3">
                @mensajeError
            </div>
        }

        @if (reservaConfirmada)
        {
            <div class="alert alert-success mt-3">
                Cita registrada correctamente.

                <a href="/cliente/citas" class="alert-link ms-1">
                    Ver mis citas
                </a>
            </div>
        }

    </div>
</div>

@code {

    // Parametros recibidos desde Disponibilidad
    [SupplyParameterFromQuery(Name = "empleadoId")]
    public int? EmpleadoIdQuery { get; set; }

    [SupplyParameterFromQuery(Name = "fecha")]
    public string? FechaQuery { get; set; }

    [SupplyParameterFromQuery(Name = "hora")]
    public string? HoraQuery { get; set; }

    [SupplyParameterFromQuery(Name = "duracion")]
    public int? DuracionQuery { get; set; }

    // Datos del formulario
    private int mascotaId = 1;
    private int empleadoId = 0;

    private DateTime fecha = DateTime.Today.AddDays(1);
    private TimeOnly? hora = new TimeOnly(10, 0);

    private int duracionMinutos = 30;
    private string motivo = "";

    // Veterinarios reales
    private List<VeterinarioResumenDto> veterinarios = new();

    // Estado
    private bool cargandoVeterinarios = true;
    private bool procesando = false;
    private bool reservaConfirmada = false;
    private string mensajeError = "";

    // Cargar veterinarios y recibir seleccion
    protected override async Task OnParametersSetAsync()
    {
        cargandoVeterinarios = true;
        mensajeError = "";

        try
        {
            veterinarios = await VeterinarioService.ListarAsync();

            if (EmpleadoIdQuery.HasValue)
            {
                int id = EmpleadoIdQuery.Value;

                if (veterinarios.Any(v => v.EmpleadoId == id))
                {
                    empleadoId = id;
                }
                else
                {
                    empleadoId = 0;
                    mensajeError = "El veterinario seleccionado no está disponible.";
                }
            }

            if (!string.IsNullOrWhiteSpace(FechaQuery) &&
                DateTime.TryParseExact(
                    FechaQuery,
                    "yyyy-MM-dd",
                    CultureInfo.InvariantCulture,
                    DateTimeStyles.None,
                    out DateTime fechaRecibida))
            {
                fecha = fechaRecibida;
            }

            if (!string.IsNullOrWhiteSpace(HoraQuery) &&
                TimeOnly.TryParse(HoraQuery, out TimeOnly horaRecibida))
            {
                hora = horaRecibida;
            }

            if (DuracionQuery.HasValue &&
                (DuracionQuery.Value == 30 ||
                 DuracionQuery.Value == 45 ||
                 DuracionQuery.Value == 60))
            {
                duracionMinutos = DuracionQuery.Value;
            }
        }
        catch (Exception ex)
        {
            mensajeError = "Error al cargar veterinarios: " + ex.Message;
        }
        finally
        {
            cargandoVeterinarios = false;
        }
    }

    // Registrar cita mediante Java
    private async Task ConfirmarReserva()
    {
        if (procesando || reservaConfirmada)
            return;

        mensajeError = "";

        if (mascotaId <= 0 || empleadoId <= 0)
        {
            mensajeError = "Seleccione una mascota y un veterinario.";
            return;
        }

        if (!veterinarios.Any(v => v.EmpleadoId == empleadoId))
        {
            mensajeError = "Seleccione un veterinario válido.";
            return;
        }

        if (!hora.HasValue)
        {
            mensajeError = "Seleccione una hora.";
            return;
        }

        DateTime fechaInicio =
            fecha.Date.Add(hora.Value.ToTimeSpan());

        if (fechaInicio <= DateTime.Now)
        {
            mensajeError = "La fecha y hora deben ser futuras.";
            return;
        }

        if (string.IsNullOrWhiteSpace(motivo))
        {
            mensajeError = "Ingrese el motivo de la cita.";
            return;
        }

        DateTime fechaFin =
            fechaInicio.AddMinutes(duracionMinutos);

        procesando = true;

        try
        {
            // Comprobar nuevamente el horario
            var horariosLibres =
                await DisponibilidadService.ConsultarAsync(
                    empleadoId, fecha, duracionMinutos);

            bool horarioDisponible = horariosLibres.Any(h =>
                TimeOnly.TryParse(h, out var horaLibre) &&
                horaLibre == TimeOnly.FromDateTime(fechaInicio));

            if (!horarioDisponible)
            {
                mensajeError =
                    "El horario seleccionado ya no está disponible.";
                return;
            }

            // Crear cita
            Cita nuevaCita = new Cita
            {
                MascotaId = mascotaId,
                EmpleadoId = empleadoId,
                FechaHoraInicio = fechaInicio,
                FechaHoraFin = fechaFin,
                Motivo = motivo.Trim()
            };

            bool resultado =
                await CitaService.RegistrarAsync(nuevaCita);

            if (resultado)
            {
                reservaConfirmada = true;
            }
            else
            {
                mensajeError = "No se pudo registrar la cita.";
            }
        }
        catch (Exception ex)
        {
            mensajeError = "Error al reservar: " + ex.Message;
        }
        finally
        {
            procesando = false;
        }
    }

    
    private int Hora24
    {
        get => hora?.Hour ?? 10;
        set => hora = new TimeOnly(value, hora?.Minute ?? 0);
    }

    private int Minuto
    {
        get => hora?.Minute ?? 0;
        set => hora = new TimeOnly(hora?.Hour ?? 10, value);
    }

}
