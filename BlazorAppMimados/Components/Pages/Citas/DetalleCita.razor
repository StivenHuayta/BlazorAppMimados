@page "/cliente/citas/detalle/{Id:int}"
@rendermode InteractiveServer

<PageTitle>Detalle de Cita - Mimados</PageTitle>

<div class="container mt-4" style="max-width: 850px;">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
        <h2 class="mb-0">Detalle de Cita</h2>
        <a class="btn btn-secondary" href="/cliente/citas"><i class="bi bi-arrow-left me-1"></i> Mis Citas</a>
    </div>

    <div class="card shadow-sm border-0 bg-light">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
            <h5 class="mb-0 fw-bold">Cita @Codigo</h5>
            <span class="badge @(Id == 2 ? "bg-warning text-dark" : "bg-success")">@Estado</span>
        </div>
        <div class="card-body p-4">
            <div class="row g-3">
                <div class="col-md-6"><span class="text-muted">Mascota</span><p class="fw-semibold mb-0">@Mascota</p></div>
                <div class="col-md-6"><span class="text-muted">Servicio</span><p class="fw-semibold mb-0">@Servicio</p></div>
                <div class="col-md-6"><span class="text-muted">Sede</span><p class="fw-semibold mb-0">@Sede</p></div>
                <div class="col-md-6"><span class="text-muted">Fecha y hora</span><p class="fw-semibold mb-0">@FechaHora</p></div>
                <div class="col-md-6"><span class="text-muted">Veterinario</span><p class="fw-semibold mb-0">@Veterinario</p></div>
                <div class="col-md-6"><span class="text-muted">Observaciones</span><p class="fw-semibold mb-0">Evaluación de rutina</p></div>
            </div>
        </div>
        <div class="card-footer bg-white d-flex flex-wrap justify-content-end gap-2 py-3">
            <a class="btn btn-warning fw-bold" href="@($"/cliente/citas/editar/{Id}")"><i class="bi bi-pencil-square me-1"></i> Editar</a>
            <a class="btn btn-outline-danger" href="@($"/cliente/citas/cancelar/{Id}")"><i class="bi bi-x-circle me-1"></i> Cancelar cita</a>
        </div>
    </div>
</div>

@code {
    [Parameter] public int Id { get; set; }
    private string Codigo => Id == 2 ? "C-002" : "C-001";
    private string Mascota => Id == 2 ? "Michi" : "Firulais";
    private string Servicio => Id == 2 ? "Vacunación" : "Consulta general";
    private string Sede => Id == 2 ? "Surco" : "San Miguel";
    private string FechaHora => Id == 2 ? "07/11/2026, 03:30 p. m." : "04/11/2026, 10:00 a. m.";
    private string Veterinario => Id == 2 ? "Dr. Luis Ramírez" : "Dra. Ana Torres";
    private string Estado => Id == 2 ? "Pendiente" : "Confirmada";
}
