@page "/cliente/citas/cancelar/{Id:int}"
@rendermode InteractiveServer

<PageTitle>Cancelar Cita - Mimados</PageTitle>

<div class="container mt-4" style="max-width: 650px;">
    <div class="d-flex justify-content-between align-items-center mb-4 gap-2">
        <h2 class="mb-0">Cancelar Cita</h2>
        <a class="btn btn-secondary" href="/cliente/citas"><i class="bi bi-arrow-left me-1"></i> Mis Citas</a>
    </div>

    <div class="card shadow-sm border-0 bg-light">
        <div class="card-header bg-danger text-white">
            <h5 class="mb-0"><i class="bi bi-exclamation-triangle me-2"></i>Confirmación de cancelación</h5>
        </div>
        <div class="card-body p-4">
            <p>¿Deseas cancelar la cita <strong>@Codigo</strong> de <strong>@Mascota</strong>?</p>
            <div class="mb-3">
                <label for="cancelar-motivo" class="form-label fw-bold">Motivo de cancelación (opcional):</label>
                <textarea id="cancelar-motivo" rows="3" class="form-control" placeholder="Escribe el motivo"></textarea>
            </div>
                        <div class="d-flex flex-wrap justify-content-end gap-2">
                <a class="btn btn-secondary" href="@($"/cliente/citas/detalle/{Id}")">Volver</a>
                <button type="button" class="btn btn-danger" @onclick="ConfirmarCancelacion">Confirmar Cancelación</button>
            </div>
            @if (cancelacionConfirmada)
            {
                <div class="alert alert-success mt-3 mb-0" role="status">Cita cancelada correctamente. <a class="alert-link" href="/cliente/citas">Volver a Mis Citas</a></div>
            }
        </div>
    </div>
</div>

@code {
    [Parameter] public int Id { get; set; }
    private string Codigo => Id == 2 ? "C-002" : "C-001";
    private string Mascota => Id == 2 ? "Michi" : "Firulais";
    private bool cancelacionConfirmada;
    private void ConfirmarCancelacion() => cancelacionConfirmada = true;
}
