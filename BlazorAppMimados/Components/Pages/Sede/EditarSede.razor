@page "/sede/administrar/editar/{Id:int}"
@rendermode InteractiveServer
@using Mimados_WebApp.Models
@using System.ComponentModel.DataAnnotations
@inject NavigationManager Nav
@inject ISedeService SedeService

<div class="container-fluid mt-4">
    
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Editar Sede</h2>
        <button class="btn btn-secondary" @onclick="Volver">
            <i class="bi bi-arrow-left"></i> Volver a Administrar Sedes
        </button>
    </div>

    @if (editarSede == null)
    {
        <div class="alert alert-info">Cargando datos de la mascota...</div>
    }
    else
    {
        <div class="card p-4 shadow-sm border-0 bg-light">
            
            @* Reutilizamos el EditForm con validación nativa (Diapositiva 39) *@
            <EditForm Model="@editarSede" OnValidSubmit="ActualizarMascota">
                <DataAnnotationsValidator />

                <div class="mb-3">
                <label class="form-label fw-bold">Nombre de la Sede:</label>
                <InputText @bind-Value="editarSede.Nombre" class="form-control" placeholder="Ej. Sede ..." />
                <ValidationMessage For="@(() => editarSede.Nombre)" class="text-danger small" />
            </div>

            <div class="row">
                
                <div class="col-md-6 mb-3">
                    <label class="form-label fw-bold">Direccion:</label>
                    <InputText @bind-Value="editarSede.Direccion" class="form-control" placeholder="Ej. Av. ..." />
                    <ValidationMessage For="@(() => editarSede.Direccion)" class="text-danger small" />

                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label fw-bold">Telefono:</label>
                    <InputText @bind-Value="editarSede.Telefono" class="form-control" placeholder="Ej. 999 999 999" />
                    <ValidationMessage For="@(() => editarSede.Telefono)" class="text-danger small" />
                </div>
            </div>

            <div class="form-check form-switch mb-3">

                <InputCheckbox id="estadoActivo" @bind-Value="editarSede.Activo" class="form-check-input switch-activo-rojo" role="switch" />
                <label class="form-check-label" for="estadoActivo">
                    @(editarSede.Activo ? "Activo" : "Inactivo")
                   </label>
            </div>



                <div class="text-end">
                    <button type="submit" class="btn btn-warning px-4 fw-bold text-dark">
                        <i class="bi bi-pencil-square"></i> Actualizar Datos
                    </button>
                </div>
            </EditForm>
        </div>


        <div class="mt-4">

        <div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="fw-bold text-secondary m-0">
        <i class="fas fa-bone text-warning me-2"></i> Listado de Servicios
    </h3>
    <a href="/servicio/nuevo" class="btn btn-success">
        <i class="bi bi-plus-circle me-1"></i> Nuevo Servicio
    </a>
</div>
    <Card Title="Lista de Servicios"
          FooterClass="text-secondary small"
          BodyClass="p-0">
        

        <ChildContent>
        

        @* TODO: a vanilla-JS datatable library (Tabulator/Simple-DataTables) could be
           initialised against this table to make search, sort and pagination live. *@
        <table class="table table-hover align-middle mb-0">
            <thead class="align-middle ">
                <tr>
                    <th style="width: 60px">
                         #
                    </th>
                    <th>
                            Nombre 
                    </th>
                    <th>
                            Descripcion 
                    </th>
                    <th>
                            Precio referencial 
                    </th>
                    <th>
                            Duracion en minutos
                    </th>
                    
                    <th style="width: 130px" class="text-center">Estado</th>
                    <th style="width: 130px">
                        
                            Editar 
                        
                    </th>
                </tr>
            </thead>
            <tbody>
                @foreach (var ser in listaServicios)
                {
                    <tr class="align-middle">
                        <td>@ser.Id</td>
                        <td>@ser.Nombre</td>
                        <td>@ser.Descripcion</td>
                        <td>@ser.PrecioReferencial</td>
                        <td>@ser.DuracionMinutos</td>
                        <td class="text-center align-middle">
                        @if (ser.Activo)
                            {
                                
                                <span class="badge bg-success px-2 py-1">Activo</span>
                               }
                        else
                            {

                            <span class="badge bg-danger px-2 py-1">Inactivo</span>
                            }
                    </td>
                    <td >
                        <button class="btn btn-danger btn-sm" ">
                             Desactivar
                        </button>
                    </td>
                        
                    </tr>
                }
            </tbody>
        </table>
        </ChildContent>
    </Card>
    </div>
    }
</div>

@code {
    [Parameter]
    public int Id { get; set; }

    List<Servicio> listaServicios = new List<Servicio>();
    


    private SedeEditar editarSede = new SedeEditar ();

    private bool cargando = true;
    private bool guardando = false;
    private string? mensajeError;



    protected override async Task OnInitializedAsync()
    {
        try
        {
            // 1. Consultamos la sede existente usando el método que creaste
            var sedeBD = await SedeService.ObtenerSedePorIdAsync(Id);

            if (sedeBD != null)
            {
                // 2. Pasamos los datos de la base de datos al modelo del formulario
                editarSede = new SedeEditar
                {
                    Nombre = sedeBD.Nombre,
                    Direccion = sedeBD.Direccion,
                    Telefono = sedeBD.Telefono,
                    Activo = sedeBD.Activo
                };
            }
            else
            {
                mensajeError = "No se encontró la sede solicitada.";
            }
        }
        catch (Exception ex)
        {
            mensajeError = $"Error al cargar la sede: {ex.Message}";
        }
        finally
        {
            cargando = false;
        }
    }


    

    private void Volver()
    {
        Nav.NavigateTo("/sede/administrar");

    }
    private void ActualizarMascota()
    {
        // Aquí usarías HttpClient (PUT) para actualizar en BD
        Console.WriteLine($"Actualizando datos de la sede ID {Id}: {editarSede?.Nombre}");
        
        // Regresamos a la grilla principal
        Nav.NavigateTo("/sede/administrar");
    }

    public class SedeEditar
    {
    [Required(ErrorMessage = "El nombre de la sede es obligatorio")]
    public string Nombre { get; set; } = string.Empty;

    [Required(ErrorMessage = "La dirección es obligatoria")]
    public string Direccion { get; set; } = string.Empty;

    [Required(ErrorMessage = "El teléfono es obligatorio")]
    [Phone(ErrorMessage = "Ingrese un número de teléfono válido")]
    public string Telefono { get; set; } = string.Empty;

    public bool Activo { get; set; } = true;
    }

}
