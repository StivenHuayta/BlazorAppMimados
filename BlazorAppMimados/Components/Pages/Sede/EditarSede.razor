@page "/sede/administrar/editar/{Id:int}"
@rendermode InteractiveServer
@using System.ComponentModel.DataAnnotations
@inject NavigationManager Nav

<div class="container-fluid mt-4">
    
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Editar Sede</h2>
        <button class="btn btn-secondary" @onclick="Volver">
            <i class="bi bi-arrow-left"></i> Volver a Administrar Sedes
        </button>
    </div>

    @if (editarSede == null)
    {
        <div class="alert alert-info">Cargando datos de la mascota...</div>
    }
    else
    {
        <div class="card p-4 shadow-sm border-0 bg-light">
            
            @* Reutilizamos el EditForm con validación nativa (Diapositiva 39) *@
            <EditForm Model="@editarSede" OnValidSubmit="ActualizarMascota">
                <DataAnnotationsValidator />

                <div class="mb-3">
                <label class="form-label fw-bold">Nombre de la Sede:</label>
                <InputText @bind-Value="editarSede.Nombre" class="form-control" placeholder="Ej. Sede ..." />
                <ValidationMessage For="@(() => editarSede.Nombre)" class="text-danger small" />
            </div>

            <div class="row">
                
                <div class="col-md-6 mb-3">
                    <label class="form-label fw-bold">Direccion:</label>
                    <InputText @bind-Value="editarSede.Direccion" class="form-control" placeholder="Ej. Av. ..." />
                    <ValidationMessage For="@(() => editarSede.Direccion)" class="text-danger small" />

                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label fw-bold">Telefono:</label>
                    <InputText @bind-Value="editarSede.Telefono" class="form-control" placeholder="Ej. 999 999 999" />
                    <ValidationMessage For="@(() => editarSede.Telefono)" class="text-danger small" />
                </div>
            </div>

            <div class="form-check form-switch mb-3">

                <InputCheckbox id="estadoActivo" @bind-Value="editarSede.Activo" class="form-check-input switch-activo-rojo" role="switch" />
                <label class="form-check-label" for="estadoActivo">
                    @(editarSede.Activo ? "Activo" : "Inactivo")
                   </label>
            </div>



                <div class="text-end">
                    <button type="submit" class="btn btn-warning px-4 fw-bold text-dark">
                        <i class="bi bi-pencil-square"></i> Actualizar Datos
                    </button>
                </div>
            </EditForm>
        </div>
    }
</div>

@code {
    [Parameter]
    public int Id { get; set; }




    private SedeEditar editarSede = new SedeEditar ();


    protected override void OnInitialized()
    {
        // Simulamos buscar la mascota en la Base de Datos usando el Id que llegó en la URL
        Console.WriteLine($"Buscando en BD la mascota con ID: {Id}");

        // Simulación de carga de datos para rellenar el formulario
        if (Id == 1)
        {
              editarSede = new SedeEditar
                                        {
                                            Nombre = "Sede Central - Lima",
                                            Direccion = "Av. Javier Prado 123",
                                            Telefono = "987654321",
                                            Activo = true
                                        };
        }
        else if (Id == 2)
        {
             editarSede = new SedeEditar
                                        {
                                            Nombre = "Sede Norte - Los Olivos",
                                            Direccion = "Av. Alfredo Mendiola 456",
                                            Telefono = "912345678",
                                            Activo = true
                                        };
        }
        else
        {
            // Si inventan un ID que no existe, cargamos un modelo vacío o podemos redirigir a un error
            editarSede = new SedeEditar ();
        }
    }

    private void Volver()
    {
        Nav.NavigateTo("/sede/administrar");

    }
    private void ActualizarMascota()
    {
        // Aquí usarías HttpClient (PUT) para actualizar en BD
        Console.WriteLine($"Actualizando datos de la sede ID {Id}: {editarSede?.Nombre}");
        
        // Regresamos a la grilla principal
        Nav.NavigateTo("/sede/administrar");
    }

    public class SedeEditar
    {
    [Required(ErrorMessage = "El nombre de la sede es obligatorio")]
    public string Nombre { get; set; } = string.Empty;

    [Required(ErrorMessage = "La dirección es obligatoria")]
    public string Direccion { get; set; } = string.Empty;

    [Required(ErrorMessage = "El teléfono es obligatorio")]
    [Phone(ErrorMessage = "Ingrese un número de teléfono válido")]
    public string Telefono { get; set; } = string.Empty;

    public bool Activo { get; set; } = true;
    }

}
