@* Ruta que exige un número entero como parámetro (Diapositiva 25) *@
@page "/cliente/mascotas/editar/{Id:int}"
@rendermode InteractiveServer
@using System.ComponentModel.DataAnnotations
@inject NavigationManager Nav

<div class="container mt-4" style="max-width: 600px;">
    
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Editar Mascota</h2>
        <button class="btn btn-secondary" @onclick="Volver">
            <i class="bi bi-arrow-left"></i> Volver a Mis Mascotas
        </button>
    </div>

    @if (mascotaAEditar == null)
    {
        <div class="alert alert-info">Cargando datos de la mascota...</div>
    }
    else
    {
        <div class="card p-4 shadow-sm border-0 bg-light">
            
            @* Reutilizamos el EditForm con validación nativa (Diapositiva 39) *@
            <EditForm Model="@mascotaAEditar" OnValidSubmit="ActualizarMascota">
                <DataAnnotationsValidator />

                <div class="mb-3">
                    <label class="form-label fw-bold">Nombre de la Mascota:</label>
                    <InputText @bind-Value="mascotaAEditar.Nombre" class="form-control" />
                    <ValidationMessage For="@(() => mascotaAEditar.Nombre)" class="text-danger small" />
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">Especie:</label>
                        <InputSelect @bind-Value="mascotaAEditar.Especie" class="form-select">
                            <option value="">-- Seleccione --</option>
                            <option value="Perro">Perro</option>
                            <option value="Gato">Gato</option>
                            <option value="Conejo">Conejo</option>
                            <option value="Ave">Ave</option>
                            <option value="Otro">Otro</option>
                        </InputSelect>
                        <ValidationMessage For="@(() => mascotaAEditar.Especie)" class="text-danger small" />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">Raza (Opcional):</label>
                        <InputText @bind-Value="mascotaAEditar.Raza" class="form-control" />
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">Sexo:</label>
                        <InputSelect @bind-Value="mascotaAEditar.Sexo" class="form-select">
                            <option value="">-- Seleccione --</option>
                            <option value="Macho">Macho</option>
                            <option value="Hembra">Hembra</option>
                        </InputSelect>
                        <ValidationMessage For="@(() => mascotaAEditar.Sexo)" class="text-danger small" />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">Fecha de Nacimiento:</label>
                        <InputDate @bind-Value="mascotaAEditar.FechaNacimiento" class="form-control" />
                        <ValidationMessage For="@(() => mascotaAEditar.FechaNacimiento)" class="text-danger small" />
                    </div>
                </div>

                <div class="mb-4">
                    <label class="form-label fw-bold">Peso Referencial (kg):</label>
                    <InputNumber @bind-Value="mascotaAEditar.PesoReferencial" class="form-control" step="0.1" />
                    <ValidationMessage For="@(() => mascotaAEditar.PesoReferencial)" class="text-danger small" />
                </div>

                <div class="text-end">
                    <button type="submit" class="btn btn-warning px-4 fw-bold text-dark">
                        <i class="bi bi-pencil-square"></i> Actualizar Datos
                    </button>
                </div>
            </EditForm>
        </div>
    }
</div>

@code {
    // Declaramos el parámetro que viene de la URL (Diapositiva 25)
    [Parameter]
    public int Id { get; set; }

    private MascotaEditarModel? mascotaAEditar;

    // Se ejecuta al inicializar el componente (Diapositiva 35)
    protected override void OnInitialized()
    {
        // Simulamos buscar la mascota en la Base de Datos usando el Id que llegó en la URL
        Console.WriteLine($"Buscando en BD la mascota con ID: {Id}");
        
        // Simulación de carga de datos para rellenar el formulario
        if (Id == 1)
        {
            mascotaAEditar = new MascotaEditarModel { Id = 1, Nombre = "Firulais", Especie = "Perro", Raza = "Mestizo", Sexo = "Macho", FechaNacimiento = new DateTime(2020, 5, 10), PesoReferencial = 15.5m };
        }
        else if (Id == 2)
        {
            mascotaAEditar = new MascotaEditarModel { Id = 2, Nombre = "Michi", Especie = "Gato", Raza = "Siamés", Sexo = "Hembra", FechaNacimiento = new DateTime(2022, 8, 20), PesoReferencial = 4.2m };
        }
        else
        {
            // Si inventan un ID que no existe, cargamos un modelo vacío o podemos redirigir a un error
            mascotaAEditar = new MascotaEditarModel { FechaNacimiento = DateTime.Today };
        }
    }

    private void ActualizarMascota()
    {
        // Aquí usarías HttpClient (PUT) para actualizar en BD
        Console.WriteLine($"Actualizando datos de la mascota ID {Id}: {mascotaAEditar?.Nombre}");
        
        // Regresamos a la grilla principal
        Nav.NavigateTo("/cliente/mascotas");
    }

    private void Volver()
    {
        Nav.NavigateTo("/cliente/mascotas");
    }

    // Modelo de datos interno (similar al de creación, pero puede incluir el ID)
    public class MascotaEditarModel
    {
        public int Id { get; set; }
        
        [Required(ErrorMessage = "El nombre es obligatorio")]
        public string Nombre { get; set; } = string.Empty;

        [Required(ErrorMessage = "Seleccione una especie")]
        public string Especie { get; set; } = string.Empty;

        public string Raza { get; set; } = string.Empty;

        [Required(ErrorMessage = "Seleccione el sexo")]
        public string Sexo { get; set; } = string.Empty;

        [Required(ErrorMessage = "La fecha es obligatoria")]
        public DateTime FechaNacimiento { get; set; }

        [Range(0.1, 150.0, ErrorMessage = "Ingrese un peso válido en kg")]
        public decimal PesoReferencial { get; set; }
    }
}