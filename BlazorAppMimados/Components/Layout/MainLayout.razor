@inherits LayoutComponentBase
@inject NavigationManager Navegacion
@implements IDisposable

<div class="app-wrapper @(colapsarSidebar ? "sidebar-collapse" : "")">
    <!-- Barra superior (Navbar) -->
    <nav class="app-header navbar navbar-expand bg-body shadow-sm">
        <div class="container-fluid">
            <!-- Botón colapsar menú lateral y título -->
            <ul class="navbar-nav">
                <li class="nav-item">
                    <button type="button" class="nav-link btn btn-link border-0 shadow-none text-dark" @onclick="ToggleSidebar">
                        <i class="bi bi-list fs-4"></i>
                    </button>
                </li>
                <li class="nav-item d-none d-md-block">
                    <span class="navbar-text fw-bold text-success">
                        🐾 Clínica Veterinaria Mimados
                    </span>
                </li>
            </ul>

            <!-- Menú derecho de usuario -->
            <ul class="navbar-nav ms-auto">
                <li class="nav-item dropdown">
                    <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">
                        <i class="bi bi-person-circle me-1"></i> @EtiquetaUsuario
                    </a>
                    <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                        @if (EsAdmin)
                        {
                            <li><a class="dropdown-item" href="/admin/perfil"><i class="bi bi-person-fill me-2"></i>Mi Perfil</a></li>
                            <li><hr class="dropdown-divider"></li>
                        }
                        else if (EsPersonalVeterinario)
                        {
                            <li><a class="dropdown-item" href="/veterinario/citas"><i class="bi bi-calendar-check me-2"></i>Mis Citas</a></li>
                            <li><a class="dropdown-item" href="/veterinario/historial"><i class="bi bi-journal-medical me-2"></i>Historial Pacientes</a></li>
                            <li><hr class="dropdown-divider"></li>
                        }
                        else
                        {
                            <li><a class="dropdown-item" href="/cliente/perfil"><i class="bi bi-gear me-2"></i>Mi Cuenta</a></li>
                            <li><hr class="dropdown-divider"></li>
                        }
                        <li><a class="dropdown-item text-danger" href="/login"><i class="bi bi-box-arrow-right me-2"></i>Cerrar Sesión</a></li>
                    </ul>
                </li>
            </ul>
        </div>
    </nav>

    <!-- Barra lateral (Sidebar) donde se incrusta tu componente NavMenu -->
    <aside class="app-sidebar bg-body-secondary shadow" data-bs-theme="dark">
        <!-- Logo o Marca del Sistema -->
        <div class="sidebar-brand">
            <a href="/" class="brand-link text-decoration-none">
                <span class="brand-text fw-bold">Mimados Vet</span>
            </a>
        </div>

        <!-- Contenedor del menú de navegación -->
        <div class="sidebar-wrapper">
            <NavMenu />
        </div>
    </aside>

    <!-- Contenido principal (@Body) -->
    <main class="app-main">
        <div class="app-content-header py-3">
            <div class="container-fluid">
            </div>
        </div>

        <div class="app-content">
            <div class="container-fluid">
                @Body
            </div>
        </div>
    </main>

    <!-- Pie de página -->
    <footer class="app-footer">
        <div class="float-end d-none d-sm-block">
            © 2025 Clínica Veterinaria Mimados
        </div>
    </footer>
</div>

@code {
    private bool colapsarSidebar = false;

    private bool EsPersonalVeterinario =>
        Navegacion.Uri.Contains("/empleado", StringComparison.OrdinalIgnoreCase) ||
        Navegacion.Uri.Contains("/veterinario", StringComparison.OrdinalIgnoreCase);

    private bool EsAdmin =>
        Navegacion.Uri.Contains("/admin", StringComparison.OrdinalIgnoreCase) ||
        Navegacion.Uri.Contains("/empleados", StringComparison.OrdinalIgnoreCase) ||
        Navegacion.Uri.Contains("/horarios", StringComparison.OrdinalIgnoreCase) ||
        Navegacion.Uri.Contains("/reportes", StringComparison.OrdinalIgnoreCase);

    private string EtiquetaUsuario
    {
        get
        {
            if (EsAdmin) return "Administrador";
            if (EsPersonalVeterinario) return "Dr. Carlos Mendoza (Veterinario)";
            return "Cliente";
        }
    }

    private void ToggleSidebar()
    {
        colapsarSidebar = !colapsarSidebar;
    }

    protected override void OnInitialized()
    {
        Navegacion.LocationChanged += ActualizarBarra;
    }

    private void ActualizarBarra(object? sender, LocationChangedEventArgs e)
    {
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Navegacion.LocationChanged -= ActualizarBarra;
    }
}

