@inherits LayoutComponentBase
@inject NavigationManager Navegacion
@implements IDisposable

<div class="app-wrapper @(colapsarSidebar ? "sidebar-collapse" : "")">
    <!-- Barra superior (Navbar) -->
    <nav class="app-header navbar navbar-expand bg-body shadow-sm">
        <div class="container-fluid">
            <!-- Botón colapsar menú lateral y título -->
            <ul class="navbar-nav">
                <li class="nav-item">
                    <!-- Cambiado de <a> con href="#" a <button> con @onclick -->
                    <button type="button" class="nav-link btn btn-link border-0 shadow-none text-dark" @onclick="ToggleSidebar">
                        <i class="bi bi-list fs-4"></i>
                    </button>
                </li>
                <li class="nav-item d-none d-md-block">
                    <span class="navbar-text fw-bold text-success">
                        🐾 Clínica Veterinaria Mimados
                    </span>
                </li>
            </ul>

            <!-- Menú derecho de usuario -->
            <ul class="navbar-nav ms-auto">
                <li class="nav-item dropdown">
                    <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">
                        <i class="bi bi-person-circle me-1"></i> @(EsPersonalVeterinario ? "Personal Veterinario" : "Cliente")
                    </a>
                    <ul class="dropdown-menu dropdown-menu-end">
                        @if (!EsPersonalVeterinario)
                        {
                            <li><a class="dropdown-item" href="/cliente/perfil"><i class="bi bi-gear me-2"></i>Mi Cuenta</a></li>
                        }
                        <li><hr class="dropdown-divider"></li>
                        <li><a class="dropdown-item text-danger" href="/login"><i class="bi bi-box-arrow-right me-2"></i>Cerrar Sesión</a></li>
                    </ul>
                </li>
            </ul>
        </div>
    </nav>

    <!-- Barra lateral (Sidebar) donde se incrusta tu componente NavMenu -->
    <aside class="app-sidebar bg-body-secondary shadow" data-bs-theme="dark">
        <!-- Logo o Marca del Sistema -->
        <div class="sidebar-brand">
            <a href="/" class="brand-link text-decoration-none">
                <span class="brand-text fw-bold">Mimados Vet</span>
            </a>
        </div>

        <!-- Contenedor del menú de navegación -->
        <div class="sidebar-wrapper">
            <NavMenu />
        </div>
    </aside>

    <!-- Contenido principal (@Body) -->
    <main class="app-main">
        <div class="app-content-header py-3">
            <div class="container-fluid">
                <!-- Espacio para migas de pan (breadcrumbs) o títulos de página si lo requieres -->
            </div>
        </div>

        <div class="app-content">
            <div class="container-fluid">
                @Body
            </div>
        </div>
    </main>

    <!-- Pie de página -->
    <footer class="app-footer">
        <div class="float-end d-none d-sm-block">
            © 2025 Clínica Veterinaria Mimados
        </div>
    </footer>
</div>

@code {
    private bool EsPersonalVeterinario =>
        Navegacion.ToBaseRelativePath(Navegacion.Uri)
            .StartsWith("empleado/", StringComparison.OrdinalIgnoreCase);

    protected override void OnInitialized()
    {
        Navegacion.LocationChanged += ActualizarBarra;
    }

    private void ActualizarBarra(object? sender, LocationChangedEventArgs e)
    {
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Navegacion.LocationChanged -= ActualizarBarra;
    }
}
