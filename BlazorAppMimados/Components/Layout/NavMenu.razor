@inject NavigationManager Navegacion
@implements IDisposable

<nav class="mt-2">
    <ul class="nav sidebar-menu flex-column" data-lte-toggle="treeview" role="menu">
        @if (EsPersonalVeterinario)
        {
            <li class="nav-header text-uppercase text-secondary mt-2">OPERACIÓN CLÍNICA</li>
            <li class="nav-item">
                <NavLink class="nav-link" href="veterinario/citas">
                    <i class="nav-icon bi bi-calendar-check-fill"></i>
                    <p>Citas Asignadas</p>
                </NavLink>
            </li>
            <li class="nav-item">
                <NavLink class="nav-link" href="veterinario/historial">
                    <i class="nav-icon bi bi-journal-medical"></i>
                    <p>Historial del Paciente</p>
                </NavLink>
            </li>
            <li class="nav-item">
                <NavLink class="nav-link" href="veterinario/atenciones/nueva">
                    <i class="nav-icon bi bi-clipboard2-pulse-fill"></i>
                    <p>Registrar Atención</p>
                </NavLink>
            </li>
            <li class="nav-item">
                <NavLink class="nav-link" href="empleado/citas" Match="NavLinkMatch.Prefix">
                    <i class="nav-icon bi bi-calendar3"></i>
                    <p>Gestión de Citas</p>
                </NavLink>
            </li>
        }
        else if (EsAdmin)
        {
            <li class="nav-header text-uppercase text-secondary mt-2">ADMINISTRACIÓN</li>
            <li class="nav-item">
                <NavLink class="nav-link" href="admin/inicio">
                    <i class="nav-icon bi bi-house-door-fill"></i>
                    <p>Inicio</p>
                </NavLink>
            </li>
            <li class="nav-item">
                <NavLink class="nav-link" href="empleados">
                    <i class="nav-icon bi bi-people-fill"></i>
                    <p>Empleados</p>
                </NavLink>
            </li>
            <li class="nav-item">
                <NavLink class="nav-link" href="horarios">
                    <i class="nav-icon bi bi-clock-fill"></i>
                    <p>Horarios</p>
                </NavLink>
            </li>
            <li class="nav-item">
                <NavLink class="nav-link" href="reportes/citas">
                    <i class="nav-icon bi bi-file-earmark-bar-graph-fill"></i>
                    <p>Reporte Citas</p>
                </NavLink>
            </li>
            <li class="nav-item">
                <NavLink class="nav-link" href="admin/perfil">
                    <i class="nav-icon bi bi-person-fill"></i>
                    <p>Mi Perfil</p>
                </NavLink>
            </li>
        }
        else
        {
            <li class="nav-header text-uppercase text-secondary mt-2">ÁREA CLIENTE</li>
            <li class="nav-item">
                <NavLink class="nav-link" href="cliente/mascotas" Match="NavLinkMatch.All">
                    <i class="nav-icon bi bi-heart-pulse"></i>
                    <p>Mis Mascotas</p>
                </NavLink>
            </li>
            <li class="nav-item">
                <NavLink class="nav-link" href="cliente/citas" Match="NavLinkMatch.All">
                    <i class="nav-icon bi bi-calendar-check"></i>
                    <p>Mis Citas</p>
                </NavLink>
            </li>
            <li class="nav-item">
                <NavLink class="nav-link" href="cliente/citas/nueva">
                    <i class="nav-icon bi bi-calendar-plus"></i>
                    <p>Reservar Cita</p>
                </NavLink>
            </li>
            <li class="nav-item">
                <NavLink class="nav-link" href="cliente/citas/disponibilidad">
                    <i class="nav-icon bi bi-clock-history"></i>
                    <p>Disponibilidad</p>
                </NavLink>
            </li>
            <li class="nav-item">
                <NavLink class="nav-link" href="cliente/perfil">
                    <i class="nav-icon bi bi-person-circle"></i>
                    <p>Mi Perfil</p>
                </NavLink>
            </li>
        }

        <li class="nav-header text-uppercase text-secondary mt-2">SESIÓN</li>
        <li class="nav-item">
            <NavLink class="nav-link text-danger" href="login">
                <i class="nav-icon bi bi-box-arrow-right"></i>
                <p>Salir</p>
            </NavLink>
        </li>
    </ul>
</nav>

@code {
    private bool EsPersonalVeterinario =>
        Navegacion.Uri.Contains("/empleado", StringComparison.OrdinalIgnoreCase) ||
        Navegacion.Uri.Contains("/veterinario", StringComparison.OrdinalIgnoreCase);

    private bool EsAdmin =>
        Navegacion.Uri.Contains("/admin", StringComparison.OrdinalIgnoreCase) ||
        Navegacion.Uri.Contains("/empleados", StringComparison.OrdinalIgnoreCase) ||
        Navegacion.Uri.Contains("/horarios", StringComparison.OrdinalIgnoreCase) ||
        Navegacion.Uri.Contains("/reportes", StringComparison.OrdinalIgnoreCase);

    protected override void OnInitialized()
    {
        Navegacion.LocationChanged += ActualizarMenu;
    }

    private void ActualizarMenu(object? sender, LocationChangedEventArgs e)
    {
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Navegacion.LocationChanged -= ActualizarMenu;
    }
}

