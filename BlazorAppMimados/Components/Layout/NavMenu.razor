@inject NavigationManager Navigation

<div class="nav-scrollable">
    <nav class="flex-column">
        @if (esAdmin)
        {
            <!-- VISTA ADMINISTRADOR -->
            <div class="px-3 my-2 text-uppercase text-muted small fw-bold">ADMINISTRACIÓN</div>
            
            <!-- NUEVO: Enlace a Inicio -->
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="/admin/inicio">
                    <span class="bi bi-house-door-fill me-2" aria-hidden="true"></span> Inicio
                </NavLink>
            </div>
            
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="/empleados">
                    <span class="bi bi-people-fill me-2" aria-hidden="true"></span> Empleados
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="/horarios">
                    <span class="bi bi-clock-fill me-2" aria-hidden="true"></span> Horarios
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="/reportes/citas">
                    <span class="bi bi-file-earmark-bar-graph-fill me-2" aria-hidden="true"></span> Reporte Citas
                </NavLink>
            </div>

            <!-- SECCIÓN CUENTA EN ADMINISTRADOR -->
            <div class="px-3 my-2 text-uppercase text-muted small fw-bold">CUENTA</div>
            
            <!-- NUEVO: Enlace a Perfil Admin -->
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="/admin/perfil">
                    <span class="bi bi-person-fill me-2" aria-hidden="true"></span> Mi Perfil
                </NavLink>
            </div>
            
            <div class="nav-item px-3">
                <NavLink class="nav-link text-danger" href="/login" Match="NavLinkMatch.All">
                    <span class="bi bi-box-arrow-right me-2" aria-hidden="true"></span> Salir
                </NavLink>
            </div>
        }
        else
        {
            <!-- VISTA CLIENTE (Se mantiene igual) -->
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="/cliente/mascotas">
                    <span class="bi bi-heart-fill me-2" aria-hidden="true"></span> Mis Mascotas
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="/cliente/citas/nueva">
                    <span class="bi bi-calendar-plus-fill me-2" aria-hidden="true"></span> Reservar Cita
                </NavLink>
            </div>

            <div class="px-3 my-2 text-uppercase text-muted small fw-bold">CUENTA</div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="/cliente/perfil">
                    <span class="bi bi-person-fill me-2" aria-hidden="true"></span> Mi Perfil
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link text-danger" href="/login" Match="NavLinkMatch.All">
                    <span class="bi bi-box-arrow-right me-2" aria-hidden="true"></span> Salir
                </NavLink>
            </div>
        }
    </nav>
</div>

@code {
    private bool esAdmin = false;

    protected override void OnInitialized()
    {
        Navigation.LocationChanged += OnLocationChanged;
        ActualizarRolSegunRuta(Navigation.Uri);
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        ActualizarRolSegunRuta(e.Location);
        StateHasChanged();
    }

    private void ActualizarRolSegunRuta(string uri)
    {
        // Se agregó la condición "/admin" para que detecte las nuevas páginas
        esAdmin = uri.Contains("/empleados") || uri.Contains("/horarios") || uri.Contains("/reportes") || uri.Contains("/admin");
    }
}