@page "/empleados"
@using Mimados.WebApp.Models
@using Mimados.WebApp.Services
@inject NavigationManager Navigation
@inject IEmpleadoService EmpleadoService

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="m-0 text-dark fw-bold">Gestión de Empleados</h3>
    <button class="btn btn-success fw-bold" @onclick="IrARegistro">
        + Registrar Nuevo Empleado
    </button>
</div>

@if (!string.IsNullOrEmpty(mensajeError))
{
    <div class="alert alert-danger mb-3">@mensajeError</div>
}

<div class="card shadow-sm border-0">
    <div class="card-header bg-primary text-white">
        <h5 class="card-title m-0 fw-bold">Lista de Empleados Registrados</h5>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle mb-0">
                <thead class="bg-light">
                    <tr>
                        <th>DNI</th>
                        <th>Nombres y Apellidos</th>
                        <th>Teléfono</th>
                        <th>Correo Electrónico</th>
                        <th>Rol</th>
                        <th>Estado</th>
                        <th class="text-center">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (listaEmpleados == null)
                    {
                        <tr>
                            <td colspan="7" class="text-center py-3">Cargando empleados...</td>
                        </tr>
                    }
                    else if (!listaEmpleados.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center py-3">No hay empleados registrados.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var emp in listaEmpleados)
                        {
                            <tr>
                                <td>@emp.Dni</td>
                                <td>@($"{emp.Nombres} {emp.Apellidos}")</td>
                                <td>@emp.Telefono</td>
                                <td>@emp.Email</td>
                                <td>@(emp.EsAdmin ? "Administrador" : "Veterinario")</td>
                                <td>
                                    @if (emp.Activo)
                                    {
                                        <span class="badge bg-success">Activo</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">Inactivo</span>
                                    }
                                </td>
                                <td class="text-center">
                                    <button class="btn btn-sm btn-warning text-dark fw-bold">Editar</button>
                                    <button class="btn btn-sm btn-danger fw-bold ms-1">Eliminar</button>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@code {
    private List<EmpleadoRequest>? listaEmpleados;
    private string? mensajeError;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var respuesta = await EmpleadoService.ListarEmpleadosAsync();
            if (respuesta != null && respuesta.Success)
            {
                listaEmpleados = respuesta.Data;
            }
            else
            {
                mensajeError = respuesta?.Message ?? "Error al cargar la lista.";
            }
        }
        catch (Exception ex)
        {
            mensajeError = "No se pudo conectar con el servidor Java. Verifica que esté en ejecución.";
        }
    }

    private void IrARegistro()
    {
        Navigation.NavigateTo("/empleados/nuevo");
    }
}
